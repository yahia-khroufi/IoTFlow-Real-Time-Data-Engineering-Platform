```env
DEVICE_ID=pc-1

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_IOT_METRICS=iot-metrics
KAFKA_CONSUMER_GROUP=spark-iot-consumer

NIFI_HOST=nifi
NIFI_PORT=8443
NIFI_USERNAME=your_nifi_username
NIFI_PASSWORD=your_nifi_password
NIFI_BASE_URL=http://nifi:8080
NIFI_INGEST_PATH=/metrics
NIFI_TIMEOUT_SECONDS=30
NIFI_VERIFY_SSL=false
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1

CASSANDRA_HOSTS=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=iot_metrics
CASSANDRA_DATACENTER=datacenter1
TABLE1=gold_table

SPARK_APP_NAME=IoTStreamingPipeline
SPARK_MASTER=local[*]

BRONZE_PATH=/data/bronze
SILVER_PATH=/data/silver
GOLD_PATH=/data/gold
REJECTED_PATH=/data/rejected
PATH_CHECK_POINT=/data/checkpoints/iot_metrics

LOG_LEVEL=INFO

POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=airflow

AIRFLOW_UID=50000
AIRFLOW_NAME=your_airflow_username
AIRFLOW_PASSWORD=your_airflow_password
AIRFLOW_FIRSTNAME=YourFirstName
AIRFLOW_LASTNAME=YourLastName
AIRFLOW_ROLE=Admin
AIRFLOW_EMAIL=your_email@example.com
```
